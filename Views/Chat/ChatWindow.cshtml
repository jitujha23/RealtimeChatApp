@using System.Security.Claims

@{
    var receiverId = ViewBag.ReceiverId;
    var receiverName = ViewBag.ReceiverName;
    var myId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

<h3>Chat with: @receiverName</h3>

<div id="chatBox"
     style="height:350px; border:1px solid #ccc; overflow-y:auto; padding:10px; background:#f9f9f9;">

    @foreach (var msg in ViewBag.Messages)
    {
        <div style="margin:5px; text-align:@(msg.SenderId == myId ? "right" : "left")">
            <span style="background:@(msg.SenderId == myId ? "#DCF8C6" : "#fff"); padding:6px 10px; border-radius:10px; display:inline-block;">
                @(msg.SenderId == myId ? "Me" : receiverName): @(msg.Message ?? "")
                @if (msg.SenderId == myId)
                {
                  @*   <span class="seenStatus">@((msg.IsSeen) ? "✔✔" : "✔")</span> *@
                    @if (msg.IsSeen)
                    {
                                                <span style="color:blue">✔✔</span>
                    }
                    else
                    {
                                                <span style="color:gray">✔</span>
                    }
                }

            </span>

            @* Show image if exists *@
            @* @if (!string.IsNullOrEmpty(msg.FilePath))
            {
                <div style="margin-top:5px;">
                    <img src="@msg.FilePath" width="150" style="border-radius:10px;" />
                </div>
            } *@
            @if (!string.IsNullOrEmpty(msg.FilePath))
            {
                var ext = System.IO.Path.GetExtension(msg.FilePath).ToLower();

            <div style="margin-top:5px;">

                    @if (ext == ".jpg" || ext == ".png" || ext == ".jpeg" || ext == ".gif")
                    {
                        <img src="@msg.FilePath" width="150" style="border-radius:10px;" />
                    }
                    else if (ext == ".mp4" || ext == ".webm")
                    {
                        <video width="200" controls>
                            <source src="@msg.FilePath" type="video/mp4">
                        </video>
                    }
                    else if (ext == ".mp3" || ext == ".wav")
                    {
                        <audio controls>
                            <source src="@msg.FilePath" type="audio/mpeg">
                        </audio>
                    }
                    else
                    {
                        <a href="@msg.FilePath" target="_blank">Download File</a>
                    }

            </div>
            }
        </div>
    }


</div>

<div id="typing" style="color:gray; height:20px;"></div>
<div id="filePreview" style="padding:5px;"></div>

@* <br /> *@
<div class="chat-input d-flex align-items-center" style="gap:10px; padding:5px; border-top:1px solid #ccc;">

    <button type="button" id="recordBtn" class="btn btn-light rounded-circle">
        <i class="fa fa-microphone"></i>
    </button>

    <div class="position-relative flex-grow-1">

        <input type="text"
               id="messageInput"
               class="form-control rounded-pill pe-5"
               placeholder="Type a message..."
               style="padding-right:90px; height:45px;" />

        <label for="fileInput"
               class="position-absolute top-50 translate-middle-y"
               style="right:55px; cursor:pointer; color:#555;">
            <i class="fa fa-paperclip"></i>
        </label>

        <input type="file" id="fileInput" hidden />

        <button class="btn btn-primary rounded-circle position-absolute top-50 translate-middle-y"
                onclick="sendMessage()"
                style="right:5px; width:38px; height:38px;">
            <i class="fa fa-paper-plane"></i>
        </button>

    </div>
</div>
