<!-- FontAwesome CDN for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">


<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const receiverId = "@receiverId";
const chatBox = document.getElementById("chatBox");

const connection = new signalR.HubConnectionBuilder()
    .withUrl("/chatHub")
    .build();

function scrollToBottom() {
    chatBox.scrollTop = chatBox.scrollHeight;
}

connection.on("ReceiveMessage", function (userId, name, message, filePath) {

    let html = "";

    if (message) {
        html += `<div style="text-align:left">
                    <span>${name}: ${message}</span>
                 </div>`;
    }

    // if (filePath) {
    //     html += `<div><img src="${filePath}" width="150"/></div>`;
    // }
   if (filePath) {

    const ext = filePath.split('.').pop().toLowerCase();

    if (["jpg","jpeg","png","gif"].includes(ext)) {

        html += `<div><img src="${filePath}" width="150"/></div>`;

    } else if (["mp4","webm"].includes(ext)) {

        html += `<video width="200" controls>
                    <source src="${filePath}">
                 </video>`;

    } else if (["mp3","wav"].includes(ext)) {

        html += `<audio controls>
                    <source src="${filePath}">
                 </audio>`;

    } else {

        html += `<a href="${filePath}" target="_blank">Download file</a>`;
    }
}

    chatBox.innerHTML += html;

    connection.invoke("MarkAsSeen", receiverId);

    scrollToBottom();
});

       connection.on("MessagesSeen", function (userId) {
        document.querySelectorAll(".seenStatus")
            .forEach(x => {
            x.innerHTML = "✔✔";
            x.style.color = "blue";
        });

    });

connection.start().then(() => {
        connection.invoke("MarkAsSeen", receiverId);
    scrollToBottom();
        document.getElementById("messageInput").focus();
});

async function sendMessage() {

    const message = document.getElementById("messageInput").value;
    const file = document.getElementById("fileInput").files[0];
    const paperclipIcon = document.querySelector(".fa-paperclip");

    if (!message && !file) return;

    let formData = new FormData();
    formData.append("message", message);
    formData.append("receiver", receiverId);

    if (file) {
        formData.append("file", file);
    }

    let response = await fetch("/Chat/SendMessage", {
        method: "POST",
        body: formData
    });

    // UI me apna message turant show
    let myHtml = `<div style="text-align:right">`;

if (message) {

    myHtml += `
        <span style="
            background:#DCF8C6;
            padding:6px 10px;
            border-radius:10px;
            display:inline-block;
            max-width:75%;
        ">
            Me: ${message}

            <span class="seenStatus" style="color:gray">✔</span>
        </span>
    `;
}

if (file) {

    const url = URL.createObjectURL(file);

    if (file.type.startsWith("image/")) {

        myHtml += `
        <div style="margin-top:5px;">
            <img src="${url}" width="150" style="border-radius:10px;" />
        </div>`;

    }
    else if (file.type.startsWith("video/")) {

        myHtml += `
        <div style="margin-top:5px;">
            <video width="200" controls style="border-radius:10px;">
                <source src="${url}">
            </video>
        </div>`;

    }
    else if (file.type.startsWith("audio/")) {

        myHtml += `
        <div style="margin-top:5px;">
            <audio controls>
                <source src="${url}">
            </audio>
        </div>`;

    }
    else {

        myHtml += `
        <div style="margin-top:5px;">
            <a href="${url}" target="_blank">${file.name}</a>
        </div>`;
    }
}
// if (file) {

//     const url = URL.createObjectURL(file);

//     myHtml += `
//         <div style="margin-top:5px;">
//             <img src="${url}" width="150" style="border-radius:10px;" />
//         </div>
//     `;
// }
    // if (file) {
    //     const url = URL.createObjectURL(file);
    //     myHtml += `<br><img src="${url}" width="150"/>`;
    // }

    myHtml += `</div>`;

    chatBox.innerHTML += myHtml;

    document.getElementById("messageInput").value = "";
    document.getElementById("fileInput").value = "";
 
    // removePreview();

    // 📎 icon normal
    paperclipIcon.style.color = "#555";

    // 🔘 send button disable
    toggleSendButton();
    scrollToBottom();
}

        // ✅ ENTER key send
        document.getElementById("messageInput")
            .addEventListener("keypress", function (e) {
                connection.invoke("Typing", receiverId);

                if (e.key === "Enter") {
                        sendMessage();
                }
            });

     connection.on("UserTyping", function (name) {

        document.getElementById("typing").innerHTML =
            name + " is typing...";

        setTimeout(() => {
            document.getElementById("typing").innerHTML = "";
        }, 1000);
    });

    const fileInput = document.getElementById("fileInput");
const messageInput = document.getElementById("messageInput");
const sendBtn = document.querySelector(".btn-primary");
const paperclipIcon = document.querySelector(".fa-paperclip");

function toggleSendButton() {

    if (messageInput.value.trim() !== "" || fileInput.files.length > 0) {
        sendBtn.style.opacity = "1";
        sendBtn.disabled = false;
    } else {
        sendBtn.style.opacity = "0.5";
        sendBtn.disabled = true;
    }
}

messageInput.addEventListener("input", toggleSendButton);

fileInput.addEventListener("change", function () {

    if (this.files.length > 0) {
        paperclipIcon.style.color = "#0d6efd";
    } else {
        paperclipIcon.style.color = "#555";
    }

    toggleSendButton();
});

document.addEventListener("DOMContentLoaded", function () {

    toggleSendButton();   // 🔥 default disabled on page load

});

