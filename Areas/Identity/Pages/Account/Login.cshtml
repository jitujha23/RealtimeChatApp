@page
@model LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Swadeshi Chat App</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RealtimeChatApp.styles.css" asp-append-version="true" />
}

<style>
    body {
        margin: 0;
        background: linear-gradient(135deg,#075E54,#128C7E);
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Segoe UI', sans-serif;
    }

    .login-card {
        background: white;
        width: 400px;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.2);
        animation: fadeIn 0.4s ease-in-out;
    }

    .login-title {
        text-align: center;
        font-weight: 600;
        margin-bottom: 25px;
        color: #075E54;
    }

    .form-control {
        border-radius: 30px;
        padding: 12px 20px;
    }

    .btn-login {
        background: #075E54;
        border: none;
        border-radius: 30px;
        padding: 10px;
        font-weight: 500;
    }

        .btn-login:hover {
            background: #128C7E;
        }

    .extra-links {
        text-align: center;
        margin-top: 15px;
        font-size: 14px;
    }

        .extra-links a {
            text-decoration: none;
            color: #075E54;
        }

    .validation-summary-errors {
        font-size: 14px;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(15px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .login-wrapper {
        text-align: center;
    }

    .logo-container {
        margin-bottom: 20px;
    }

    .app-logo {
        width: 300px;
        max-width: 70%;
        height: auto;
    }
</style>
<div class="login-wrapper">
<div class="login-card">
        <div class="logo-container">
            <img src="~/images/logofinal.png" alt="SwadeshiChat Logo" class="app-logo" />
        </div>

    <form method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <input asp-for="Input.Email"
                   class="form-control"
                   placeholder="Email"
                   autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <input asp-for="Input.Password"
                   type="password"
                   class="form-control"
                   placeholder="Password"
                   autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="Input.RememberMe" class="form-check-input" />
            <label asp-for="Input.RememberMe" class="form-check-label">
                Remember me
            </label>
        </div>

        <button type="submit" class="btn btn-login w-100">
            Log In
        </button>

        <div class="extra-links">
            <div>
                <a asp-page="./ForgotPassword">Forgot password?</a>
            </div>
            <div>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                    Create new account
                </a>
            </div>
        </div>

    </form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}